# --- Phase 0-1: Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Used to build absolute booking links (e.g. in Settings and emails).
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# --- Phase 2: Google Calendar ---
# Same OAuth client configured as the Google provider in Supabase Auth
# settings. Needed here too because our server code exchanges the stored
# refresh token for an access token directly (Supabase only handles the
# initial sign-in exchange, not ongoing API calls).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Phase 3: Google Maps (Geocoding, Distance Matrix, Directions, Maps JS) ---
# Server-side key used for Geocoding + Distance Matrix (lib/geocode.ts,
# lib/distanceMatrix.ts). Restrict it to those two APIs + your server IPs.
GOOGLE_MAPS_API_KEY=
# Separate browser-exposed key for the Maps JavaScript API + Directions
# rendering (components/route/route-map.tsx). Restrict by HTTP referrer to
# your domain(s) in Google Cloud Console — it WILL be visible in page source.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Verifies requests to /api/cron/precompute-routes actually come from
# Vercel Cron (sent as `Authorization: Bearer <CRON_SECRET>`). Generate any
# long random string.
CRON_SECRET=

# --- Phase 4: Resend, Twilio, OneSignal ---
# Verified sending domain/address in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Twilio: SMS uses TWILIO_FROM_NUMBER (a purchased Twilio number). WhatsApp
# uses TWILIO_WHATSAPP_FROM — either the Twilio Sandbox number
# (whatsapp:+14155238886, without the "whatsapp:" prefix here — the code
# adds it) while testing, or your approved WhatsApp Business sender in prod.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
# OneSignal: server key (Basic <API key>, used server-side) + app id used
# both server-side and in the browser SDK.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# --- Phase 5: Anthropic (AI follow-up drafting) ---
ANTHROPIC_API_KEY=
# Optional override — defaults to a recommended model in lib/anthropic.ts.
# Check https://docs.claude.com/en/docs/about-claude/models before pinning.
# ANTHROPIC_MODEL=

# --- Phase 7: Stripe billing ---
STRIPE_SECRET_KEY=
# From the webhook endpoint's settings in the Stripe Dashboard (or `stripe
# listen` output when testing locally with the Stripe CLI).
STRIPE_WEBHOOK_SECRET=
# Price IDs (price_...) for the Pro and Business recurring prices —
# created under Products in the Stripe Dashboard.
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=

# --- Phase 8 (not needed yet, listed here so the shape is ready) ---
# (no new variables introduced by Phase 8 — see README)
